  <dependencyManagement>
    <dependencies>
      <!-- Security patch releases override Boot's older patch pins. -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson-databind-security.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
