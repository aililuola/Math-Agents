        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-bom</artifactId>
        <version>${temporal.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.github.aililuola</groupId>
        <artifactId>mathproofmesh-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aililuola</groupId>
        <artifactId>mathproofmesh-core</artifactId>
        <version>${project.version}</version>
