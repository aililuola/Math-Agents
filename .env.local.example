# Never commit real keys or tokens. Populate secrets only in the local environment.
DEEPSEEK_AGENT_1_KEY=
DEEPSEEK_AGENT_2_KEY=
DEEPSEEK_AGENT_3_KEY=
DEEPSEEK_AGENT_4_KEY=
DEEPSEEK_AGENT_5_KEY=

# Generic multi-provider profiles.
AGENT_PLANNER_KEY=
AGENT_EXPLORER_1_KEY=
AGENT_EXPLORER_2_KEY=
AGENT_VERIFIER_1_KEY=
AGENT_VERIFIER_2_KEY=
AGENT_SYNTHESIZER_KEY=

# Server, PostgreSQL, and Temporal.
MATHPROOFMESH_CONFIG=config/application.yaml
MATHPROOFMESH_SERVER_TOKEN=
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/mathproofmesh
SPRING_DATASOURCE_USERNAME=mathproofmesh
SPRING_DATASOURCE_PASSWORD=
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# Python computation sidecar. The token must differ from the server token.
MATHPROOFMESH_COMPUTE_SIDECAR_URL=http://127.0.0.1:8091
MATHPROOFMESH_COMPUTE_SIDECAR_TOKEN=
