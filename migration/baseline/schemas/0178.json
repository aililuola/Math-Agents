          "type": "string"
        },
        "title": "Hidden Assumptions",
        "type": "array"
      },
      "immediate_counterexamples": {
        "items": {
          "type": "string"
        },
        "title": "Immediate Counterexamples",
        "type": "array"
      },
      "internally_coherent": {
        "title": "Internally Coherent",
        "type": "boolean"
      },
      "proposal_id": {
        "title": "Proposal Id",
        "type": "string"
      },
      "recommendation": {
        "enum": [
          "reject",
          "store_insight",
          "attach_to_existing_route",
          "create_new_route",
          "request_computation",
