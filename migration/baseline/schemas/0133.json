{
  "qualified_name": "mathproofmesh.schemas.BudgetAction",
  "schema": {
    "$defs": {
      "ActionKind": {
        "enum": [
          "widen",
          "deepen",
          "verify",
          "synthesize",
          "revise",
          "bridge",
          "resolve_conflict",
          "search_counterexample",
          "merge_route",
          "cooldown_route",
          "switch_representation",
          "trigger_inspiration",
          "search_analogy",
          "invent_construction",
          "generate_invariant",
          "reverse_goal",
          "meta_replan",
          "surprise_widen",
          "stop"
        ],
        "title": "ActionKind",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "action": {
        "$ref": "#/$defs/ActionKind"
      },
      "blocked_reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Blocked Reason"
      },
      "eligible": {
        "default": true,
        "title": "Eligible",
        "type": "boolean"
      },
      "estimated_calls": {
        "default": 0,
        "minimum": 0,
        "title": "Estimated Calls",
        "type": "integer"
      },
      "forced": {
        "default": false,
        "title": "Forced",
        "type": "boolean"
      },
      "planned_paths": {
        "default": 0,
        "minimum": 0,
        "title": "Planned Paths",
        "type": "integer"
      },
      "rank": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rank"
      },
      "reason": {
        "title": "Reason",
        "type": "string"
      },
      "score": {
        "title": "Score",
        "type": "number"
      },
      "selected": {
        "default": false,
        "title": "Selected",
        "type": "boolean"
      },
      "strategy_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Strategy Id"
      },
      "target_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Target Id"
      }
    },
    "required": [
      "action",
      "score",
      "reason"
    ],
    "title": "BudgetAction",
    "type": "object"
  }
}
