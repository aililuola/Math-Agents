        "type": "string"
      },
      "proposal_id": {
        "title": "Proposal Id",
        "type": "string"
      },
      "record_id": {
        "title": "Record Id",
        "type": "string"
      },
      "round_index": {
        "minimum": 0,
        "title": "Round Index",
        "type": "integer"
      },
      "source_record_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
