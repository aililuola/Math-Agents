            "title": "Status",
            "type": "string"
          },
          "strategy_id": {
            "title": "Strategy Id",
            "type": "string"
          },
          "superseded_by_strategy_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Superseded By Strategy Id"
          }
        },
        "required": [
          "strategy_id",
          "parent_strategy_id",
          "root_strategy_id",
          "revision_number",
          "revision_reason",
          "preserved_mechanism_tags",
          "preserved_domain_objects",
          "removed_claim_ids",
          "added_claim_ids",
          "status"
        ],
        "title": "StrategyLineageRecord",
        "type": "object"
      },
      "StrategyRevisionReason": {
        "enum": [
          "admission_rewrite",
          "plan_failure",
          "scope_repair",
          "bridge_insertion",
          "countermodel_feedback",
          "user_intervention"
        ],
        "title": "StrategyRevisionReason",
        "type": "string"
      },
      "ToolRequest": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "domains": {
            "additionalProperties": true,
            "title": "Domains",
            "type": "object"
          },
          "kind": {
            "enum": [
              "sympy_simplify",
              "sympy_equivalent",
              "numeric_counterexample",
              "polynomial_factor",
              "modular_exhaustive",
              "bounded_integer_search",
              "graph_certificate",
              "recurrence_check",
              "bounded_greedy_sequence",
              "candidate_period_check",
              "exact_geometry",
              "lean_check"
            ],
            "title": "Kind",
            "type": "string"
          },
          "max_cases": {
            "default": 100000,
            "maximum": 100000000,
            "minimum": 1,
            "title": "Max Cases",
            "type": "integer"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "purpose"
        ],
        "title": "ToolRequest",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "added_claim_ids": {
        "items": {
          "type": "string"
        },
        "title": "Added Claim Ids",
        "type": "array"
      },
      "first_executable_obligation_id": {
        "title": "First Executable Obligation Id",
        "type": "string"
      },
      "lineage": {
        "$ref": "#/$defs/StrategyLineageRecord"
      },
      "removed_claim_ids": {
        "items": {
          "type": "string"
        },
        "title": "Removed Claim Ids",
        "type": "array"
      },
      "retained_claim_ids": {
        "items": {
          "type": "string"
        },
        "title": "Retained Claim Ids",
        "type": "array"
      },
      "revised_blueprint": {
        "$ref": "#/$defs/StrategyBlueprint"
      },
      "revised_strategy": {
        "$ref": "#/$defs/StrategyCard"
      },
      "semantic_assessment": {
        "$ref": "#/$defs/RewriteSemanticAssessment"
      }
    },
    "required": [
      "revised_strategy",
      "revised_blueprint",
      "lineage",
      "semantic_assessment",
      "retained_claim_ids",
      "removed_claim_ids",
      "added_claim_ids",
      "first_executable_obligation_id"
    ],
    "title": "RevisedStrategyResult",
    "type": "object"
  }
}
