{
  "qualified_name": "mathproofmesh.schemas.MetaStrategyDecision",
  "schema": {
    "$defs": {
      "InspirationMechanism": {
        "enum": [
          "representation_switch",
          "structural_analogy",
          "auxiliary_construction",
          "invariant_hypothesis",
          "reverse_goal_analysis",
          "bridge_lemma",
          "surprise_exploration",
          "meta_replan",
          "inspiration_composition"
        ],
        "title": "InspirationMechanism",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "continue_current_mechanism",
          "local_repair",
          "rewrite_plan",
          "switch_representation",
          "search_analogy",
          "invent_auxiliary_construction",
          "surprise_exploration",
          "merge_route",
          "split_route",
          "cooldown_route",
          "abandon_route"
        ],
        "title": "Action",
        "type": "string"
      },
      "affected_route_ids": {
        "items": {
          "type": "string"
        },
        "title": "Affected Route Ids",
        "type": "array"
      },
      "decision_id": {
        "title": "Decision Id",
        "type": "string"
      },
      "estimated_calls": {
        "default": 0,
        "minimum": 0,
        "title": "Estimated Calls",
        "type": "integer"
      },
      "observable_metrics": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "title": "Observable Metrics",
        "type": "object"
      },
      "reason": {
        "title": "Reason",
        "type": "string"
      },
      "round_index": {
        "minimum": 0,
        "title": "Round Index",
        "type": "integer"
      },
      "selected_mechanism": {
        "anyOf": [
          {
            "$ref": "#/$defs/InspirationMechanism"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "round_index",
      "action",
      "reason"
    ],
    "title": "MetaStrategyDecision",
    "type": "object"
  }
}
