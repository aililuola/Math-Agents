      "action": {
        "$ref": "#/$defs/ComputationContractRepairAction"
      },
      "reason": {
        "title": "Reason",
        "type": "string"
      },
      "repaired_spec": {
        "anyOf": [
          {
            "$ref": "#/$defs/ExperimentSpec"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "semantic_equivalence": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Semantic Equivalence"
      }
    },
    "required": [
      "action",
      "reason"
    ],
    "title": "ComputationContractRepair",
    "type": "object"
