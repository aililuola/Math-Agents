          "reasoning_basis": {
            "minLength": 1,
            "title": "Reasoning Basis",
            "type": "string"
          },
          "request_hash": {
            "default": "",
            "title": "Request Hash",
            "type": "string"
          },
          "requested_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Requested By"
          },
          "runtime_fingerprint": {
            "additionalProperties": true,
            "title": "Runtime Fingerprint",
            "type": "object"
          },
          "seed": {
            "default": 20260719,
            "title": "Seed",
            "type": "integer"
          },
          "target_claim": {
            "minLength": 1,
            "title": "Target Claim",
            "type": "string"
          },
          "typed_tool_gap": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Typed Tool Gap"
          },
          "why_computation_is_needed": {
            "minLength": 1,
            "title": "Why Computation Is Needed",
            "type": "string"
          }
