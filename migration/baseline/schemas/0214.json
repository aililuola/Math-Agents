{
  "qualified_name": "mathproofmesh.schemas.StrategyCard",
  "schema": {
    "$defs": {
      "ComputationHint": {
        "additionalProperties": false,
        "description": "A planner-authored possibility. It is deliberately not executable.",
        "properties": {
          "broad_search": {
            "default": false,
            "title": "Broad Search",
            "type": "boolean"
          },
          "decision_use": {
            "title": "Decision Use",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/$defs/ComputationPurpose"
          },
          "suggested_method": {
            "$ref": "#/$defs/ComputationMethod"
          },
          "target_claim": {
            "title": "Target Claim",
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "target_claim",
          "suggested_method",
          "decision_use"
        ],
        "title": "ComputationHint",
        "type": "object"
      },
      "ComputationMethod": {
        "enum": [
          "sympy_simplify",
          "sympy_equivalent",
          "polynomial_factor",
          "modular_exhaustive",
          "bounded_integer_search",
          "graph_certificate",
          "recurrence_check",
          "bounded_greedy_sequence",
          "candidate_period_check",
          "exact_geometry",
          "numeric_counterexample",
          "real_inequality",
          "number_theory_check",
          "sandboxed_python",
          "lean_check"
        ],
        "title": "ComputationMethod",
        "type": "string"
      },
      "ComputationPurpose": {
        "enum": [
          "falsify_claim",
          "check_derived_identity",
          "test_boundary_cases",
          "verify_finite_reduction",
          "validate_constructed_example",
          "discover_pattern"
        ],
        "title": "ComputationPurpose",
        "type": "string"
      },
      "CriticalClaim": {
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Refs",
            "type": "array"
          },
          "falsification_test": {
            "minLength": 1,
            "title": "Falsification Test",
            "type": "string"
          },
          "necessity": {
            "default": "required",
            "enum": [
              "required",
              "supporting"
            ],
            "title": "Necessity",
            "type": "string"
          },
          "preferred_tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Preferred Tool"
          },
          "statement": {
            "minLength": 1,
            "title": "Statement",
            "type": "string"
          },
          "status": {
            "default": "needs_check",
            "enum": [
              "candidate",
              "needs_check",
              "verified",
              "refuted",
              "blocked"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "statement",
          "falsification_test"
        ],
        "title": "CriticalClaim",
        "type": "object"
      },
      "EvidenceRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_ref": {
            "title": "Artifact Ref",
            "type": "string"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content Hash"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Section"
          },
          "summary": {
            "default": "",
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "artifact_ref"
        ],
        "title": "EvidenceRef",
        "type": "object"
      },
      "ToolRequest": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "domains": {
            "additionalProperties": true,
            "title": "Domains",
            "type": "object"
          },
          "kind": {
            "enum": [
              "sympy_simplify",
              "sympy_equivalent",
              "numeric_counterexample",
              "polynomial_factor",
              "modular_exhaustive",
              "bounded_integer_search",
              "graph_certificate",
              "recurrence_check",
              "bounded_greedy_sequence",
              "candidate_period_check",
              "exact_geometry",
              "lean_check"
            ],
            "title": "Kind",
            "type": "string"
          },
          "max_cases": {
            "default": 100000,
            "maximum": 100000000,
            "minimum": 1,
            "title": "Max Cases",
            "type": "integer"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "purpose"
        ],
        "title": "ToolRequest",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "assigned_agent_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Assigned Agent Id"
      },
      "bottleneck": {
        "title": "Bottleneck",
        "type": "string"
      },
      "calculation_checks": {
        "items": {
          "$ref": "#/$defs/ToolRequest"
        },
        "title": "Calculation Checks",
        "type": "array"
      },
      "calculation_evidence_refs": {
        "items": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "title": "Calculation Evidence Refs",
        "type": "array"
      },
      "computation_hints": {
        "items": {
          "$ref": "#/$defs/ComputationHint"
        },
        "title": "Computation Hints",
        "type": "array"
      },
      "core_idea": {
        "title": "Core Idea",
        "type": "string"
      },
      "critical_claims": {
        "items": {
          "$ref": "#/$defs/CriticalClaim"
        },
        "title": "Critical Claims",
        "type": "array"
      },
      "estimated_cost": {
        "default": 0.5,
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Estimated Cost",
        "type": "number"
      },
      "estimated_success": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Estimated Success",
        "type": "number"
      },
      "expected_lemmas": {
        "items": {
          "type": "string"
        },
        "title": "Expected Lemmas",
        "type": "array"
      },
      "falsification_test": {
        "title": "Falsification Test",
        "type": "string"
      },
      "independence_basis": {
        "title": "Independence Basis",
        "type": "string"
      },
      "inspiration_proposal_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Inspiration Proposal Id"
      },
      "key_original_step": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Key Original Step"
      },
      "parent_strategy_ids": {
        "items": {
          "type": "string"
        },
        "title": "Parent Strategy Ids",
        "type": "array"
      },
      "prerequisites": {
        "items": {
          "type": "string"
        },
        "title": "Prerequisites",
        "type": "array"
      },
      "strategy_id": {
        "title": "Strategy Id",
        "type": "string"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "title": "Tags",
        "type": "array"
      },
      "title": {
        "title": "Title",
        "type": "string"
      }
    },
    "required": [
      "title",
      "core_idea",
      "independence_basis",
      "bottleneck",
      "falsification_test",
      "estimated_success"
    ],
    "title": "StrategyCard",
    "type": "object"
  }
}
