{
  "qualified_name": "mathproofmesh.schemas.ProofAttempt",
  "schema": {
    "$defs": {
      "AttemptStatus": {
        "enum": [
          "complete",
          "partial",
          "failed"
        ],
        "title": "AttemptStatus",
        "type": "string"
      },
      "CandidateConjecture": {
        "additionalProperties": false,
        "description": "A computation-inspired hypothesis that is explicitly not a proved fact.",
        "properties": {
          "confidence": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "conjecture_id": {
            "title": "Conjecture Id",
            "type": "string"
          },
          "content_hash": {
            "default": "",
            "title": "Content Hash",
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "title": "Evidence Refs",
            "type": "array"
          },
          "proof_obligations": {
            "items": {
              "type": "string"
            },
            "title": "Proof Obligations",
            "type": "array"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "scope_limitations": {
            "items": {
              "type": "string"
            },
            "title": "Scope Limitations",
            "type": "array"
          },
          "statement": {
            "title": "Statement",
            "type": "string"
          },
          "status": {
            "const": "candidate",
            "default": "candidate",
            "title": "Status",
            "type": "string"
          },
          "supporting_experiment_ids": {
            "items": {
              "type": "string"
            },
            "title": "Supporting Experiment Ids",
            "type": "array"
          }
        },
        "required": [
          "statement",
          "rationale",
          "supporting_experiment_ids",
          "scope_limitations",
          "proof_obligations"
        ],
        "title": "CandidateConjecture",
        "type": "object"
      },
      "CitationRecord": {
        "additionalProperties": false,
        "properties": {
          "applicability_conditions": {
            "items": {
              "type": "string"
            },
            "title": "Applicability Conditions",
            "type": "array"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "title": "Authors",
            "type": "array"
          },
          "exact_statement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exact Statement"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Location"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Url"
          },
          "verified": {
            "default": false,
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ],
        "title": "CitationRecord",
        "type": "object"
      },
      "ClaimCard": {
        "additionalProperties": false,
        "properties": {
          "assumptions": {
            "items": {
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "conclusion": {
            "title": "Conclusion",
            "type": "string"
          },
          "content_hash": {
            "default": "",
            "title": "Content Hash",
            "type": "string"
          },
          "counterexample_risk": {
            "default": "unknown",
            "title": "Counterexample Risk",
            "type": "string"
          },
          "dependencies": {
            "items": {
              "type": "string"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "dependency_refs": {
            "items": {},
            "title": "Dependency Refs",
            "type": "array"
          },
          "evidence_refs": {
            "items": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "title": "Evidence Refs",
            "type": "array"
          },
          "proof_steps": {
            "items": {
              "$ref": "#/$defs/ProofStep"
            },
            "title": "Proof Steps",
            "type": "array"
          },
          "scope_limitations": {
            "items": {
              "type": "string"
            },
            "title": "Scope Limitations",
            "type": "array"
          },
          "self_confidence": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Self Confidence",
            "type": "number"
          },
          "source_agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Agent Id"
          },
          "source_attempt_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Attempt Id"
          },
          "source_delta_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Delta Id"
          },
          "statement": {
            "title": "Statement",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/ClaimStatus",
            "default": "proposed"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "verification_confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Verification Confidence"
          }
        },
        "required": [
          "statement",
          "conclusion"
        ],
        "title": "ClaimCard",
        "type": "object"
      },
      "ClaimStatus": {
        "enum": [
          "proposed",
          "verified",
          "rejected",
          "uncertain"
        ],
        "title": "ClaimStatus",
        "type": "string"
      },
      "EvidenceRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_ref": {
            "title": "Artifact Ref",
            "type": "string"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content Hash"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Section"
          },
          "summary": {
            "default": "",
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "artifact_ref"
        ],
        "title": "EvidenceRef",
        "type": "object"
      },
      "ProofStep": {
        "additionalProperties": false,
        "properties": {
          "branch_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Branch Label"
          },
          "calculation_checks": {
            "items": {
              "$ref": "#/$defs/ToolRequest"
            },
            "title": "Calculation Checks",
            "type": "array"
          },
          "calculation_evidence_refs": {
            "items": {
              "$ref": "#/$defs/EvidenceRef"
            },
            "title": "Calculation Evidence Refs",
            "type": "array"
          },
          "calculations": {
            "items": {
              "type": "string"
            },
            "title": "Calculations",
            "type": "array"
          },
          "citations": {
            "items": {
              "$ref": "#/$defs/CitationRecord"
            },
            "title": "Citations",
            "type": "array"
          },
          "confidence": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "dependencies": {
            "items": {
              "type": "string"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "dependency_refs": {
            "items": {},
            "title": "Dependency Refs",
            "type": "array"
          },
          "is_key_step": {
            "default": false,
            "title": "Is Key Step",
            "type": "boolean"
          },
          "justification": {
            "title": "Justification",
            "type": "string"
          },
          "statement": {
            "title": "Statement",
            "type": "string"
          },
          "step_id": {
            "title": "Step Id",
            "type": "string"
          },
          "step_type": {
            "default": "derivation",
            "enum": [
              "derivation",
              "assumption_intro",
              "assumption_discharge",
              "case_split",
              "case_close",
              "definition",
              "construction"
            ],
            "title": "Step Type",
            "type": "string"
          }
        },
        "required": [
          "step_id",
          "statement",
          "justification"
        ],
        "title": "ProofStep",
        "type": "object"
      },
      "ToolRequest": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "domains": {
            "additionalProperties": true,
            "title": "Domains",
            "type": "object"
          },
          "kind": {
            "enum": [
              "sympy_simplify",
              "sympy_equivalent",
              "numeric_counterexample",
              "polynomial_factor",
              "modular_exhaustive",
              "bounded_integer_search",
              "graph_certificate",
              "recurrence_check",
              "bounded_greedy_sequence",
              "candidate_period_check",
              "exact_geometry",
              "lean_check"
            ],
            "title": "Kind",
            "type": "string"
          },
          "max_cases": {
            "default": 100000,
            "maximum": 100000000,
            "minimum": 1,
            "title": "Max Cases",
            "type": "integer"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "purpose"
        ],
        "title": "ToolRequest",
        "type": "object"
      },
      "UsageRecord": {
        "additionalProperties": false,
        "properties": {
          "estimated_cost_usd": {
            "default": 0.0,
            "minimum": 0.0,
            "title": "Estimated Cost Usd",
            "type": "number"
          },
          "input_tokens": {
            "default": 0,
            "minimum": 0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "output_tokens": {
            "default": 0,
            "minimum": 0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "total_tokens": {
            "default": 0,
            "minimum": 0,
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "title": "UsageRecord",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "agent_id": {
        "title": "Agent Id",
        "type": "string"
      },
      "attempt_id": {
        "title": "Attempt Id",
        "type": "string"
      },
      "candidate_conjectures": {
        "items": {
          "$ref": "#/$defs/CandidateConjecture"
        },
        "title": "Candidate Conjectures",
        "type": "array"
      },
      "checkpoint_ids": {
        "items": {
          "type": "string"
        },
        "title": "Checkpoint Ids",
        "type": "array"
      },
      "dead_ends": {
        "items": {
          "type": "string"
        },
        "title": "Dead Ends",
        "type": "array"
      },
      "failover_chain": {
        "items": {
          "type": "string"
        },
        "title": "Failover Chain",
        "type": "array"
      },
      "falsification_checks": {
        "items": {
          "type": "string"
        },
        "title": "Falsification Checks",
        "type": "array"
      },
      "final_answer": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Final Answer"
      },
      "latest_checkpoint_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Latest Checkpoint Id"
      },
      "path_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Path Id"
      },
      "problem_hash": {
        "title": "Problem Hash",
        "type": "string"
      },
      "proof_sketch": {
        "default": "",
        "maxLength": 4000,
        "title": "Proof Sketch",
        "type": "string"
      },
      "proof_steps": {
        "items": {
          "$ref": "#/$defs/ProofStep"
        },
        "title": "Proof Steps",
        "type": "array"
      },
      "proposed_lemmas": {
        "items": {
          "$ref": "#/$defs/ClaimCard"
        },
        "title": "Proposed Lemmas",
        "type": "array"
      },
      "raw_artifact_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Raw Artifact Ref"
      },
      "resumed_from_checkpoint_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Resumed From Checkpoint Id"
      },
      "round_index": {
        "minimum": 0,
        "title": "Round Index",
        "type": "integer"
      },
      "segment_count": {
        "default": 0,
        "minimum": 0,
        "title": "Segment Count",
        "type": "integer"
      },
      "self_confidence": {
        "default": 0.5,
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Self Confidence",
        "type": "number"
      },
      "status": {
        "$ref": "#/$defs/AttemptStatus"
      },
      "strategy_id": {
        "title": "Strategy Id",
        "type": "string"
      },
      "unresolved_gaps": {
        "items": {
          "type": "string"
        },
        "title": "Unresolved Gaps",
        "type": "array"
      },
      "usage": {
        "$ref": "#/$defs/UsageRecord"
      }
    },
    "required": [
      "problem_hash",
      "strategy_id",
      "agent_id",
      "round_index",
      "status"
    ],
    "title": "ProofAttempt",
    "type": "object"
  }
}
