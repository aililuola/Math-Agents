{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathproofmesh.local/schemas/olympiad-5key-v1/run-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "problem_id",
    "trial_id",
    "run_id",
    "baseline_commit",
    "execution_branch",
    "execution_commit",
    "execution_dirty",
    "problem_prompt_sha256",
    "root_goal_hash_initial",
    "root_goal_hash_final",
    "config_hash",
    "pricing_hash",
    "model_id",
    "provider_id",
    "coordination_key_label",
    "research_key_labels",
    "started_at",
    "ended_at",
    "cold_start",
    "recovery_trial",
    "final_status",
    "stop_reason",
    "external_score",
    "bundle_complete"
  ],
  "properties": {
    "benchmark_id": {"const": "olympiad-5key-v1"},
    "problem_id": {"pattern": "^P(?:0[1-9]|1[0-9]|20)$"},
    "trial_id": {"pattern": "^(?:T[123]|R1)$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "baseline_commit": {"const": "ea94a34041fd32a4f94ecb1a3532ddc314430a47"},
    "execution_branch": {"type": "string", "minLength": 1},
    "execution_commit": {"pattern": "^[0-9a-f]{40}$"},
    "execution_dirty": {"type": "boolean"},
    "problem_prompt_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "root_goal_hash_initial": {"type": "string", "minLength": 1},
    "root_goal_hash_final": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "pricing_hash": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "coordination_key_label": {"enum": ["KEY_A", "KEY_B", "KEY_C", "KEY_D", "KEY_E"]},
    "research_key_labels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["KEY_A", "KEY_B", "KEY_C", "KEY_D", "KEY_E"]}
    },
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "cold_start": {"const": true},
    "recovery_trial": {"type": "boolean"},
    "final_status": {"enum": ["COMPLETE", "INCOMPLETE", "REFUTED", "UNCERTAIN", "INVALID"]},
    "stop_reason": {"type": "string"},
    "external_score": {"type": "null"},
    "bundle_complete": {"type": "boolean"}
  }
}
