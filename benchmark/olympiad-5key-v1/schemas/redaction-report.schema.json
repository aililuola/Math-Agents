{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathproofmesh.local/schemas/olympiad-5key-v1/redaction-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["files_scanned", "secret_leaks", "authorization_header_leaks", "credential_pattern_leaks", "result"],
  "properties": {
    "files_scanned": {"type": "integer", "minimum": 0},
    "secret_leaks": {"type": "integer", "minimum": 0},
    "authorization_header_leaks": {"type": "integer", "minimum": 0},
    "credential_pattern_leaks": {"type": "integer", "minimum": 0},
    "result": {"enum": ["PASS", "FAIL"]}
  }
}
